    "research_items": [
      {
        "id": "168a63d4-80d9-433f-a46e-d5fb1277aaef",
        "slug": "human-brain-development",
        "title": "Human Brain Development",
        "card_title": "Human Brain Development",
        "card_summary": "Molecular logic of cortical development and cellular diversity.",
        "subtitle": "Decoding the molecular logic of human cortical development",
        "question": "How does the human brain generate its extraordinary cellular diversity?",
        "body": "This theme investigates the molecular and transcriptional programs that regulate neural progenitor proliferation, cell-fate specification, neuronal differentiation and cortical organization during human development. It frames how the human cortex becomes unique, and how those programs can fail.",
        "extra_line": null,
        "image_url": "/images/lab/theme-development.jpg",
        "image_caption": "Cortical neurons · Fluorescence field",
        "accent": "cyan",
        "sort_order": 1,
        "published": true,
        "created_at": "2026-09-23T09:41:49.122674+00:00",
        "updated_at": "2026-09-23T09:41:49.122674+00:00"
      },
      {
        "id": "5fa8d057-1540-4107-a262-6e5a2f1f47bc",
        "slug": "rna-biology",
        "title": "RNA Biology & Isoform Diversity",
        "card_title": "RNA Biology & Isoforms",
        "card_summary": "How alternative splicing shapes identity and disease risk.",
        "subtitle": "Beyond genes: the complexity of RNA isoforms",
        "question": "How does RNA processing create molecular diversity that shapes fate and disease?",
        "body": "The genome provides the blueprint; RNA processing creates enormous molecular diversity. A major focus is alternative splicing and isoform diversity during human brain development and in neurological disease, and how changes in RNA processing alter cellular identity, trajectories and susceptibility.",
        "extra_line": null,
        "image_url": "/images/lab/theme-rna.jpg",
        "image_caption": "RNA splicing · Isoform diversity",
        "accent": "magenta",
        "sort_order": 2,
        "published": true,
        "created_at": "2026-09-23T09:41:49.122674+00:00",
        "updated_at": "2026-09-23T09:41:49.122674+00:00"
      },
      {
        "id": "d6df6f9c-e9d0-49a2-89d5-4b7194914521",
        "slug": "organoids",
        "title": "Human Brain Organoids & Assembloids",
        "card_title": "Organoids & Assembloids",
        "card_summary": "Human brain models: cortical, interneuron and vascular systems.",
        "subtitle": "Building the human brain in a dish",
        "question": "How can human-relevant models capture interactions animal systems miss?",
        "body": "Patient-derived and human iPSC-derived cortical, interneuron and vascular organoids, and increasingly complex assembloids, model development and disease in a genetically authentic human context, enabling mechanism studies and therapeutic testing.",
        "extra_line": null,
        "image_url": "/images/lab/theme-organoids.jpg",
        "image_caption": "Human cerebral organoids · Culture systems",
        "accent": "amber",
        "sort_order": 3,
        "published": true,
        "created_at": "2026-09-23T09:41:49.122674+00:00",
        "updated_at": "2026-09-23T09:41:49.122674+00:00"
      },
      {
        "id": "d3b27af7-e775-4662-a4b6-84dd89d93366",
        "slug": "single-cell",
        "title": "Single-Cell & Spatial Neuroscience",
        "card_title": "Single-Cell & Spatial",
        "card_summary": "Mapping development and disease at single-cell resolution.",
        "subtitle": "Mapping the human brain at single-cell resolution",
        "question": "How do we connect genes to circuits across development and disease?",
        "body": "Single-cell, single-nucleus and spatial technologies map cellular and molecular diversity across stages and disease states, connecting:",
        "extra_line": "Genes → RNA → Cell States → Cellular Interactions → Neural Circuits → Disease Phenotypes",
        "image_url": "/images/lab/theme-spatial.jpg",
        "image_caption": "Cellular architecture · Multicolor fluorescence",
        "accent": "cyan",
        "sort_order": 4,
        "published": true,
        "created_at": "2026-09-23T09:41:49.122674+00:00",
        "updated_at": "2026-09-23T09:41:49.122674+00:00"
      },
      {
        "id": "540e8294-bb5b-4c0d-8a9b-fb0609ddb602",
        "slug": "disease",
        "title": "Neurodevelopmental & Psychiatric Disorders",
        "card_title": "Neurodevelopmental Disease",
        "card_summary": "Autism, Down syndrome, bipolar disorder and schizophrenia.",
        "subtitle": "From developmental biology to disease mechanisms",
        "question": "How do early developmental disruptions become clinical disease?",
        "body": "Many neurological and psychiatric disorders have roots in early development. This work investigates Autism Spectrum Disorder, Down syndrome, bipolar disorder and schizophrenia, combining patient-derived iPSCs with multi-organoid models and multimodal profiling to explain why patients with the same diagnosis can show very different biology.",
        "extra_line": null,
        "image_url": "/images/lab/theme-disease.jpg",
        "image_caption": "Spiny neuron · Confocal microscopy",
        "accent": "magenta",
        "sort_order": 5,
        "published": true,
        "created_at": "2026-09-23T09:41:49.122674+00:00",
        "updated_at": "2026-09-23T09:41:49.122674+00:00"
      },
      {
        "id": "f4d2a0c0-236a-4f71-ac2c-d92f32f68960",
        "slug": "precision-psychiatry",
        "title": "Precision Psychiatry",
        "card_title": "Precision Psychiatry",
        "card_summary": "Biological subtypes and mechanism-based therapies.",
        "subtitle": "From patient heterogeneity to precision medicine",
        "question": "Can we define biological subtypes that guide mechanism-based therapy?",
        "body": "Two patients with the same diagnosis may have different underlying mechanisms. The long-term vision combines clinical phenotyping, patient-derived iPSCs, organoids, single-cell genomics, functional phenotyping and computation to identify biological subtypes and develop mechanism-based strategies.",
        "extra_line": null,
